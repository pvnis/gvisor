+        NV_PRINTF(LEVEL_ERROR,
+                  "GHOST 0d: ctxshare 0x%08x SET_CWD_WATERMARK(1)=0x%x GET=0x%x readback=%u\n",
+                  hCtxShare, sWm, sWmGet, wm.watermarkValue);
+    }
